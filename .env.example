# من @BotFather
TELEGRAM_BOT_TOKEN=123456:ABC...
# اختياري: رقم المحادثة (أو أرسل /start للبوت في الوضع المستمر)
TELEGRAM_CHAT_ID=

TARGET_URL=https://netacademy.sa/book?activity=tennis&type=trainer
# كلمات يتعرف فيها على المدرب (عربي/إنجليزي)، مفصولة بفواصل
TRAINER_KEYWORDS=الداعج,داعج,daej,daij,da3j,daaj
TRAINER_LABEL=محمد الداعج
# الفحص كل كم ثانية
CHECK_INTERVAL=300
# اضغط على اسم المدرب لو الصفحة تحتاج اختياره عشان تظهر الأوقات
CLICK_TRAINER=1

# --- وضع الـ API (الأفضل) ---
# شغّل: python bot.py --find-api  وانسخ السطور المقترحة هنا
# لو فيه تاريخ في الرابط بدّله بـ {date} والبوت يفحص من اليوم إلى DAYS_AHEAD يوم قدام
API_URL=
API_METHOD=GET
# هيدرز إضافية بصيغة JSON إذا احتاجها الموقع
API_HEADERS=
API_BODY=
DAYS_AHEAD=14
# لو فشل الـ API يرجع لطريقة المتصفح
BROWSER_FALLBACK=1
