# من @BotFather
TELEGRAM_BOT_TOKEN=123456:ABC...
# اختياري: رقم المحادثة (أو أرسل /start للبوت في الوضع المستمر)
TELEGRAM_CHAT_ID=

TARGET_URL=https://netacademy.sa/book?activity=tennis&type=trainer
# كلمات يتعرف فيها على المدرب (عربي/إنجليزي)، مفصولة بفواصل
TRAINER_KEYWORDS=الداعج,داعج,aldaaj,daaj,daej,daij,da3j
TRAINER_LABEL=محمد الداعج
# الفحص كل كم ثانية في باقي اليوم (عشان الإلغاءات)
CHECK_INTERVAL=120
# اضغط على اسم المدرب لو الصفحة تحتاج اختياره عشان تظهر الأوقات
CLICK_TRAINER=1

# كم يوم قدام يفحص (الأكاديمية تنزّل الحصص ليومين قدام)
DAYS_AHEAD=3
# الحصص تنزل كل ليلة الساعة 12 (بتوقيت الرياض): يفحص كل FAST_CHECK_INTERVAL ثانية
# من قبلها بدقيقتين إلى بعدها بربع ساعة
RELEASE_TIME=00:00
FAST_CHECK_INTERVAL=10
RELEASE_WINDOW_BEFORE_MIN=2
RELEASE_WINDOW_AFTER_MIN=15
# يقرأ الحصص من Server Action حق الموقع مباشرة (الأفضل)
USE_SERVER_ACTION=1

# --- وضع API مخصص (اختياري، يتقدّم على الـ Server Action لو تعبّى) ---
# شغّل: python bot.py --find-api  وانسخ السطور المقترحة هنا
# لو فيه تاريخ في الرابط بدّله بـ {date} والبوت يفحص من اليوم إلى DAYS_AHEAD يوم قدام
API_URL=
API_METHOD=GET
# هيدرز إضافية بصيغة JSON إذا احتاجها الموقع
API_HEADERS=
API_BODY=
# لو فشل الـ API يرجع لطريقة المتصفح
BROWSER_FALLBACK=1
